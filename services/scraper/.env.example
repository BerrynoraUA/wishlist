SCRAPER_HOST=127.0.0.1
SCRAPER_PORT=8001
SCRAPER_LOG_LEVEL=info
SCRAPER_AUDIT_LOG_PATH=.data/scrape-audit.jsonl
SCRAPER_AUDIT_LOG_MAX_BYTES=20971520
SCRAPER_AUDIT_LOG_BACKUPS=5
SCRAPER_ADAPTIVE_DB_PATH=.data/adaptive.db
SCRAPER_ENABLE_ADAPTIVE=true
SCRAPER_ADAPTIVE_MATCH_PERCENTAGE=60
SCRAPER_HTTP_TIMEOUT_SECONDS=8
SCRAPER_HTTP_MAX_REDIRECTS=8
SCRAPER_MAX_RESPONSE_BYTES=5242880
SCRAPER_BROWSER_TIMEOUT_MS=15000
SCRAPER_BROWSER_MAX_PAGES=2
SCRAPER_ENABLE_BROWSER=true
SCRAPER_ENABLE_JINA=true
