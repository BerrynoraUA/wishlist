# Copy to `.env` in this folder. Values are from Supabase: Project Settings → API.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# PostHog (https://posthog.com/docs/libraries/react-native) — project API key and ingest host (US or EU).
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# General Translation (https://generaltranslation.com/docs/react-native/tutorials/quickstart-expo)
# Dev keys from https://dash.generaltranslation.com/ or `npx gt auth` — use gtx-dev- for local development.
EXPO_PUBLIC_GT_PROJECT_ID=
EXPO_PUBLIC_GT_DEV_API_KEY=
