# Copy to .env.store.local (gitignored) and fill in before running `eas metadata:push`.
# These are App Store Connect App Review values only - they are not used by the app at runtime.

# Contact phone for the App Review team, E.164 format.
APPLE_REVIEW_PHONE=+380000000000

# Permanent demo account the reviewer signs in with. Must stay alive between releases.
APPLE_DEMO_USERNAME=appreview@wishlane.net
APPLE_DEMO_PASSWORD=
