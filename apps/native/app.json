{
  "expo": {
    "name": "Wishlane",
    "slug": "wishlane",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "wishlane",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*"],
    "updates": {
      "url": "https://u.expo.dev/50371ce7-ec58-411c-ab43-d42fce223c68"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.berrynora.wishlane",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.berrynora.wishlane",
      "googleServicesFile": "./google-services.json",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Wishlane to choose a profile image from your library.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/splash-mascot.png",
          "imageWidth": 240,
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/images/splash-mascot.png",
            "imageWidth": 240
          }
        }
      ],
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ],
      "expo-localization",
      [
        "expo-notifications",
        {
          "color": "#208AEF",
          "defaultChannel": "default"
        }
      ],
      "expo-apple-authentication",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Wishlane to securely switch between saved accounts."
        }
      ],
      [
        "expo-web-browser",
        {
          "experimentalLauncherActivity": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "50371ce7-ec58-411c-ab43-d42fce223c68"
      }
    },
    "owner": "berrynora"
  }
}
