{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:translated": "gtx-cli translate && next build",
    "start": "next start",
    "lint": "eslint",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:update-snapshots": "playwright test --update-snapshots",
    "test:e2e:critical": "playwright test --config playwright.critical.config.ts",
    "test:e2e:critical:ui": "playwright test --config playwright.critical.config.ts --ui",
    "test:e2e:critical:update-snapshots": "playwright test --config playwright.critical.config.ts --update-snapshots",
    "test:e2e:secondary": "playwright test --config playwright.secondary.config.ts",
    "test:e2e:secondary:ui": "playwright test --config playwright.secondary.config.ts --ui",
    "test:e2e:secondary:update-snapshots": "playwright test --config playwright.secondary.config.ts --update-snapshots",
    "gt:translate": "gtx-cli translate"
  },
  "dependencies": {
    "@paddle/paddle-js": "^1.6.2",
    "@revenuecat/purchases-js": "^1.28.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.94.0",
    "@tanstack/react-query": "^5.90.20",
    "cheerio": "^1.2.0",
    "framer-motion": "^12.33.0",
    "gt-next": "^6.15.2",
    "lucide-react": "^0.563.0",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.1",
    "sharp": "^0.34.5",
    "supabase": "^2.75.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "gtx-cli": "^2.14.4",
    "sass": "^1.97.3",
    "typescript": "5.9.3"
  }
}
