{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "check-types": {},
    "translate": {
      "cache": false
    },
    "android": {
      "cache": false,
      "persistent": true,
      "env": ["ANDROID_HOME", "ANDROID_SDK_ROOT", "JAVA_HOME", "Path"]
    },
    "ios": {
      "cache": false,
      "persistent": true,
      "env": ["JAVA_HOME", "Path"]
    }
  }
}
