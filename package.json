{
  "name": "wishlist",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --filter=frontend --filter=native",
    "build": "turbo run build --filter=frontend",
    "web": "turbo run dev --filter=frontend",
    "web:https": "turbo run dev:https --filter=frontend",
    "dev:https": "turbo run dev:https --filter=frontend",
    "native": "turbo run dev --filter=native",
    "scrapling": "node services/scraper/scripts/start.mjs",
    "scraper:bundle": "pnpm --filter @wishlist/scraper-core build:bundle",
    "android": "turbo run android --filter=native",
    "ios": "turbo run ios --filter=native",
    "test": "pnpm --filter frontend test:e2e",
    "test:unit": "turbo run test",
    "test:scripts": "vitest run",
    "screenshots": "node scripts/showcase/showcase.ts",
    "screenshots:android": "node scripts/showcase/showcase.ts --platform android",
    "screenshots:validate": "node scripts/showcase/showcase.ts --validate-only",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix --fix-suggestions --fix-dangerously",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "ref": "pnpm lint:fix && pnpm format:fix",
    "check-types": "turbo run check-types",
    "db:types": "pnpm exec supabase gen types typescript --local > packages/backend/db-types/database.ts",
    "db:diff": "node scripts/db-diff.mjs",
    "translate": "turbo run translate --filter=frontend --filter=native",
    "clean": "pnpm -r exec -- node -e \"const fs=require('fs');try{fs.rmSync('node_modules',{recursive:true,force:true});console.log('Deleted node_modules')}catch(e){}\" && node -e \"const fs=require('fs');try{fs.rmSync('node_modules',{recursive:true,force:true});console.log('Deleted root node_modules')}catch(e){}\" && pnpm store prune"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.103.0",
    "@types/pngjs": "^6.0.5",
    "node-gyp": "^12.4.0",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.60.0",
    "pngjs": "^7.0.0",
    "sharp": "^0.34.5",
    "supabase": "^2.109.1",
    "turbo": "^2.9.6",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.20.0"
}
