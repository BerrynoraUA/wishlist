# Keep this file aligned with the repository .gitignore. EAS CLI uses it instead
# of .gitignore when creating build and workflow upload archives.
node_modules/
.next/
.expo/
dist/
build/
out/
*.tsbuildinfo
pnpm-debug.log

# Environment files
.env
.env.local
.env.*.local
.env.db-diff

# Build artifacts
*.crx
*.pem
*.vs

# Generated by apps/native/extract-strings.mjs
full-en-map.json

.turbo
apps/native/credentials.json
apps/native/credentials/
apps/native/*.jks
apps/native/android/app/*.jks

apps/native/*firebase-adminsdk*.json
.pnpm-store/
.pnpm-debug.log*

# Local tooling state and version-control metadata are not build inputs.
.git
.fallow

# Native projects are generated from app.json during EAS Build (CNG).
# These root-relative rules also work around EAS CLI's Windows bug where
# nested .gitignore rules are not applied to monorepo archives.
apps/native/android
apps/native/ios
apps/native/.expo
apps/native/dist
apps/native/web-build

# Native-only local and credential files covered by apps/native/.gitignore.
apps/native/*.orig.*
apps/native/*.p8
apps/native/*.p12
apps/native/*.key
apps/native/*.mobileprovision
apps/native/.metro-health-check*
apps/native/npm-debug.*
apps/native/yarn-debug.*
apps/native/yarn-error.*
apps/native/.DS_Store
apps/native/*.pem
apps/native/.env*.local
apps/native/store.config.json
apps/native/expo-env.d.ts

# Workspaces and repository tooling that the native app does not depend on.
.agents
.claude
.cursor
.github
.vscode
apps/frontend
services
supabase
